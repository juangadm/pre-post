{
  "name": "@juangadm/pre-post",
  "version": "1.2.0",
  "description": "Before/after screenshots for pull requests: detect changed routes, capture, pixel-diff, and post a sticky PR comment",
  "author": "Juan Gabriel Delgado (forked from James Clements)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juangadm/pre-post.git"
  },
  "homepage": "https://github.com/juangadm/pre-post",
  "bugs": {
    "url": "https://github.com/juangadm/pre-post/issues"
  },
  "keywords": [
    "screenshot",
    "before-after",
    "visual-diff",
    "visual-regression",
    "pull-request",
    "playwright",
    "pixelmatch",
    "cli",
    "claude-code-skill"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pre-post": "dist/bin/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.pkg.json",
    "prepare": "npm run build",
    "prepublishOnly": "rm -rf dist && npm run build && npm run test:unit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:browser": "TEST_BROWSER=true vitest run tests/browser tests/integration",
    "test:integration": "vitest run tests/integration"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "typescript": "5.7.3",
    "vitest": "^3.2.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3"
    }
  },
  "dependencies": {
    "pixelmatch": "^7.2.0",
    "playwright-core": "1.58.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
